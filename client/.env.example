# ──────────────────────────────────────────────────────────────────────────────
# Collabo CRM — Client Environment Variables
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# All client env vars MUST be prefixed with VITE_ to be exposed to the browser.
# These are baked into the build at compile time — they are NOT secret.
# ──────────────────────────────────────────────────────────────────────────────

# API base URL — point this at your deployed NestJS backend.
#
# Local dev (NestJS on host):     http://localhost:5000/api/v1
# Local dev (NestJS in Docker):   http://localhost:8080/api/v1
# Production (DigitalOcean API):  https://api.yourdomain.com/api/v1
#
# On Cloudflare Pages, set this in:
#   Project Settings → Environment variables → VITE_API_BASE_URL
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Preview-only modules: Chat, Campaigns and Logistics.
#
# These sections are UI running on mock/placeholder data — there are no backend
# endpoints for them yet. Leave this UNSET: they are visible under `npm run dev`
# and hidden in every build, which is what production wants.
#
# Set to "true" only for a staging build where you want to demo them, or to
# "false" under the dev server to preview exactly what production will show.
# VITE_SHOW_PREVIEW_MODULES=true

# Meta (Facebook) app id, for the WhatsApp Embedded Signup popup.
#
# The WhatsApp connect flow runs inside Meta's JavaScript SDK rather than a
# redirect, so the browser needs the app id — the server's META_APP_ID cannot
# reach it. Must be the SAME app as the server's META_APP_ID, and must be set at
# BUILD time: Vite bakes VITE_* vars into the bundle, so setting it only on the
# runtime host leaves the popup unable to start.
#
# Without it, Settings → Channels → Connect WhatsApp Business reports that the
# Meta SDK is unavailable. Instagram is unaffected: it uses a server-side
# redirect and needs nothing here.
VITE_META_APP_ID=
