# ──────────────────────────────────────────────────────────────────────────────
# Server-only environment template for the DigitalOcean Droplet deployment.
#
# Copy to .env and fill in real values:
#   cp .env.example .env
#
# Then start the API:
#   docker compose up -d --build
# ──────────────────────────────────────────────────────────────────────────────

# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=80

# ─── External database + Redis ───────────────────────────────────────────────
# DigitalOcean Managed Postgres (prod since 2026-09-21, see
# docs/db-cutover-supabase-to-digitalocean.md):
#   DATABASE_URL = connection pool "crm" (PgBouncer, TRANSACTION mode, port 25061)
#                  ?pgbouncer=true&connection_limit=10&pool_timeout=20&sslmode=require
#   DIRECT_URL   = direct connection (port 25060), used only by prisma migrate
#                  ?sslmode=require
# Both MUST name the same host: prisma/scripts/print-target.js refuses to run
# fix scripts when they differ. sslmode=require is mandatory — DO refuses
# plaintext connections and a missing flag shows up as the api container
# restart-looping on `prisma migrate deploy`.
DATABASE_URL=postgresql://doadmin:password@your-cluster.g.db.ondigitalocean.com:25061/crm?pgbouncer=true&connection_limit=10&pool_timeout=20&sslmode=require
DIRECT_URL=postgresql://doadmin:password@your-cluster.g.db.ondigitalocean.com:25060/defaultdb?sslmode=require
REDIS_URL=redis://your-redis-host:6379

# ─── App URLs ────────────────────────────────────────────────────────────────
# Where the frontend lives (used for CORS allowlist + email links)
FRONTEND_URL=https://your-frontend.pages.dev
# Reverse-proxy hops in front of the API, so rate limits and logs see the real
# client IP. 1 behind Caddy (DigitalOcean); leave unset when Node is hit directly.
TRUST_PROXY=1
# Public URL of this API (used for OAuth callbacks, webhook URLs)
APP_URL=https://api.yourdomain.com

# ─── JWT Secrets (REQUIRED — generate 32+ char random strings) ──────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_random_32_char_or_longer_string
JWT_REFRESH_SECRET=replace_with_different_random_32_char_string

# ─── Super Admin (Collabo team) ─────────────────────────────────────────────
# Comma-separated list of emails that auto-become super admins on login.
# Super admins can view every registered user and impersonate them for support.
# Leave empty to disable.
SUPER_ADMIN_EMAILS=

# ─── Encryption Key (exactly 32 characters) ─────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ENCRYPTION_KEY=replace_with_exactly_32_chars_xxxx

# ─── Email (Resend) — Optional ──────────────────────────────────────────────
RESEND_API_KEY=
FROM_EMAIL=noreply@yourcrm.com
FROM_NAME=Collabo CRM

# ─── Shopify Public App ─────────────────────────────────────────────────────
# Credentials of the CRM's public Shopify app (partners.shopify.com).
# Partner Dashboard / shopify.app.toml must be configured with:
#   App URL:                 the hosted embedded (Remix) app URL
#   Allowed redirection URL: {APP_URL}/api/v1/channels/shopify/callback
#   Compliance webhooks:     {APP_URL}/api/v1/webhooks/shopify (all three topics)
# The client secret is also the webhook HMAC signing key.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# MUST mirror [access_scopes] in the app's shopify.app.toml exactly.
# NOTE: read_all_orders (orders older than 60 days) requires separate Shopify approval.
SHOPIFY_SCOPES=read_products,write_products,read_orders,write_orders,read_customers,read_inventory,write_inventory,read_locations,read_reports,read_draft_orders,write_draft_orders,read_merchant_managed_fulfillment_orders,write_merchant_managed_fulfillment_orders,read_assigned_fulfillment_orders,write_assigned_fulfillment_orders,read_third_party_fulfillment_orders,write_third_party_fulfillment_orders,write_fulfillments,write_pixels,read_customer_events
SHOPIFY_API_VERSION=2026-01

# ─── Meta (Instagram + WhatsApp) — Optional ─────────────────────────────────
# One Meta app serves both channels. Setup: docs/meta-channels-setup.md
#
# Instagram uses Instagram Login: the browser goes to instagram.com and back to
#   {APP_URL}/api/v1/channels/instagram/callback
# which must be listed under Instagram → API setup with Instagram login →
# Business login settings → OAuth redirect URIs.
#
# WhatsApp instead runs Embedded Signup in a popup, so the CLIENT needs the app
# id too — set VITE_META_APP_ID in client/.env at build time.
META_APP_ID=
META_APP_SECRET=
# "Instagram app ID" / "Instagram app secret" from API setup with Instagram
# login — NOT the same values as META_APP_ID / META_APP_SECRET.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Webhook verify tokens: long random strings you choose, entered again in the
# Meta dashboard next to each callback URL ({APP_URL}/api/v1/webhooks/whatsapp,
# /webhooks/messenger, /webhooks/instagram). Deliveries are verified with
# META_APP_SECRET; these tokens only answer Meta's subscribe handshake.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
MESSENGER_WEBHOOK_VERIFY_TOKEN=
# Meta dashboard → Facebook Login for Business → Configurations →
# "WhatsApp Embedded Signup". Without it the WhatsApp connect endpoint 400s.
WHATSAPP_CONFIG_ID=
# A second Facebook Login for Business configuration for Facebook Pages and the
# Instagram accounts linked to them (Messenger + Instagram messaging).
MESSENGER_CONFIG_ID=
# Graph API version used by BOTH Meta channels. Default v21.0.
# META_GRAPH_VERSION takes precedence when set; WHATSAPP_GRAPH_VERSION is kept
# for existing deployments.
META_GRAPH_VERSION=
WHATSAPP_GRAPH_VERSION=

# ─── Inbox media ─────────────────────────────────────────────────────────────
# Where chat media copied from Meta is kept (private; served by signed links).
# Defaults to ./storage/messaging; must be a persistent volume in production.
MESSAGING_MEDIA_DIR=
# Signs those links (min 32 chars). Defaults to JWT_ACCESS_SECRET.
MESSAGING_MEDIA_SECRET=
# Local/CI only: point the Graph API client at a stand-in server.
# META_GRAPH_BASE_URL=http://localhost:7071

# ─── Outbound rate limiter (server → Shopify / Meta) ────────────────────────
# off     = no limiter, today's behaviour (kill switch)
# observe = decide and log, never wait (default; compare with real THROTTLEDs)
# enforce = reserve budget before every request, park jobs on long waits
RATE_LIMIT_MODE=observe
# Cap on any single limiter Redis call before that request proceeds unmetered.
# Raise it if your Redis is far away: a managed Redis in another region can
# have a several-hundred-millisecond tail even when its median is ~50ms.
RATE_LIMIT_REDIS_TIMEOUT_MS=500
# Cost reserved for a Shopify query never seen before (points).
RATE_LIMIT_SHOPIFY_DEFAULT_COST=50
# Fraction of the shop's bucket bulk work must leave untouched (0..0.9).
RATE_LIMIT_SHOPIFY_BULK_WATERMARK=0.30
# WhatsApp Cloud API per-phone-number throughput (messages per second).
RATE_LIMIT_META_PHONE_MPS=80
# Worker concurrency. 3 sync + 3 push + 3 whatsapp + 1 draft + 1 inventory = 11
# slots against a DB pool of 10: Prisma queues on pool_timeout rather than
# failing, so append &pool_timeout=20 to DATABASE_URL when raising these.
SHOPIFY_PUSH_CONCURRENCY=3
WHATSAPP_MESSAGING_CONCURRENCY=3
# Messages sent to Meta at once, across every workspace (inbox, automations,
# broadcasts). Per-number pacing is the rate limiter's; this bounds DB use.
MESSAGING_OUTBOUND_CONCURRENCY=5

# ─── Billing: Razorpay ──────────────────────────────────────────────────────
# Get keys at https://dashboard.razorpay.com/app/keys (start with Test mode).
# Webhook secret is set when creating a webhook in the Razorpay dashboard.
# Plan IDs live in server/src/billing/razorpay-plans.ts (checked into git).
# Without these the /billing endpoints will return 503 — the rest of the app
# runs fine.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# The Razorpay plan for each plan and currency (test and live mode have their
# own ids). A plan without one cannot be bought in that currency. See docs/billing.md.
RAZORPAY_PLAN_BASIC_INR=
RAZORPAY_PLAN_BASIC_USD=
RAZORPAY_PLAN_GROWTH_INR=
RAZORPAY_PLAN_GROWTH_USD=
# Where "Talk to us" on the Enterprise plan writes to.
BILLING_SALES_EMAIL=
# How often usage billing checks for a finished month to bill (default 3600).
# BILLING_USAGE_POLL_SECONDS=3600

# ─── Caddy reverse proxy (droplet only) ─────────────────────────────────────
# Read by docker-compose.yml, not by the NestJS app itself.
# sslip.io gives you a free hostname based on any IP (no domain needed).
# Format: <droplet-ip>.sslip.io — e.g. 168.144.82.109.sslip.io
CADDY_DOMAIN=168.144.82.109.sslip.io
# Email for Let's Encrypt cert renewal notices
CADDY_ACME_EMAIL=collabo.techteam@gmail.com
