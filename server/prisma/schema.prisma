// Prisma schema for Collabo CRM.
//
// Deploy policy (H13): shared / staging / production MUST use
// `prisma migrate deploy` only. Do not use `prisma db push` on those
// environments — it updates the live DB without a migration record and
// makes the production index set unverifiable. Partial unique indexes that
// Prisma cannot express live in SQL migrations (see
// 20260729120000_manual_order_number_unique, 20260729130000_one_active_invoice_per_order,
// 20260729140000_h13_migrate_deploy_baseline).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // App traffic goes through the Supabase pooler in transaction mode
  // (port 6543, `?pgbouncer=true`). Prisma Migrate needs a session-mode
  // connection (port 5432) for its advisory locks, hence directUrl.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OrganizationType {
  PERSONAL
  ORGANIZATION
}

enum BillingPlan {
  BASIC
  GROWTH
  ADVANCE
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum BillingProvider {
  RAZORPAY
  MANUAL // wire transfer / enterprise / comped
}

enum SubscriptionStatus {
  CREATED // subscription created on Razorpay, not yet paid
  AUTHENTICATED // first payment authorized, awaiting capture
  ACTIVE
  PAUSED
  HALTED
  CANCELLED
  COMPLETED
  EXPIRED
}

enum OnboardingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum UserRole {
  OWNER // Created the org. Cannot be removed. Full access + billing.
  ADMIN // Full access. Can invite/remove. Cannot change billing or remove owner.
  MANAGER // Manage orders, customers, campaigns. Cannot manage team.
  AGENT // View/respond to conversations, view orders. Limited write.
  VIEWER // Read-only. For stakeholders.
  VENDOR // External supplier. Locked to their own products/orders only (scoped by OrganizationMember.vendorScope).
  /// External creator invited to collaborate. Like VENDOR, this is an OUTSIDE
  /// party: deny-by-default, reachable only on routes marked @AllowInfluencer().
  /// Scoped to the channels they personally connected (Channel.ownerUserId) plus
  /// whatever PERMISSION_KEYS their membership grants.
  INFLUENCER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum ChannelPlatform {
  SHOPIFY
  WOOCOMMERCE
  INSTAGRAM
  FACEBOOK
  WHATSAPP
  TIKTOK
  MANUAL
}

enum ChannelStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  SYNCING
}

enum SyncStatus {
  IDLE
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

// Warehouse location hierarchy levels. One self-referencing table
// (WarehouseLocation) models Zone → Rack → Shelf → Bin at any depth; the
// scannable identity is the materialized fullCode ("WH1-A01-S02-B03").
enum LocationType {
  ZONE
  RACK
  SHELF
  BIN
}

// Physical stock buckets on StockLevel. Closed set for V1 — Picked/Packed/
// Dispatched are PickTask statuses (stock stays RESERVED until dispatch),
// transfers are paired ledger events, returns end in AVAILABLE or DAMAGED.
// INCOMING / IN_TRANSIT are planned V2 additions.
enum StockBucket {
  AVAILABLE
  RESERVED
  QC
  DAMAGED
}

enum OrderFinancialStatus {
  PENDING
  AUTHORIZED
  PARTIALLY_PAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  VOIDED
}

enum OrderFulfillmentStatus {
  UNFULFILLED
  FULFILLED
  PARTIAL
  RESTOCKED
}

enum OrderCancelReason {
  CUSTOMER
  FRAUD
  INVENTORY
  DECLINED
  OTHER
}

enum DraftOrderStatus {
  OPEN // Draft is editable
  INVOICE_SENT // Shopify invoice email sent; customer can pay via the hosted link
  COMPLETED // Draft was converted into a real Order
}

enum CustomerState {
  ENABLED
  DISABLED
  DECLINED
  INVITED
}

enum GstType {
  CGST_SGST // Intra-state: Central GST + State GST
  IGST // Inter-state: Integrated GST
}

/// How a supply is classified for GST reporting.
///
/// NIL_RATED, EXEMPT and NON_GST all attract zero tax but are reported in
/// different places (GSTR-1 Table 8, GSTR-3B 3.1(c) vs 3.1(e)), so they cannot
/// be inferred from a 0% rate — they are a property of the goods and must be
/// classified on the Product. ZERO_RATED is the exception: it is DERIVED from
/// an export place of supply, never configured.
enum GstSupplyType {
  TAXABLE
  EXEMPT
  NIL_RATED
  NON_GST
  ZERO_RATED

  @@map("GstSupplyType")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  CANCELLED
  CREDIT_NOTE
}

/// Where a ProductVariant.barcode came from. See the field comment on
/// ProductVariant.barcodeSource — this drives regeneration, pull-overwrite and
/// Shopify-push decisions, so classify honestly.
enum BarcodeSource {
  /// Minted by SkuGeneratorService. Ours to replace; must survive a Shopify
  /// pull that carries no barcode; never pushed unless the org opts in.
  GENERATED
  /// Typed by a person, or imported from CSV. Left alone.
  MANUAL
  /// Came down from Shopify — usually a real GTIN. Shopify stays authoritative.
  SHOPIFY
}

enum VipLevel {
  NONE
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum LoyaltyMetric {
  ORDERS
  TOTAL_SPENT
}

model User {
  id                            String              @id @default(cuid())
  email                         String              @unique
  password                      String // bcrypt hash
  firstName                     String              @map("first_name") // Required at signup
  lastName                      String              @map("last_name") // Required at signup
  avatarUrl                     String?             @map("avatar_url") // Optional profile picture
  emailVerified                 Boolean             @default(false) @map("email_verified")
  emailVerifiedAt               DateTime?           @map("email_verified_at")
  emailVerifyCode               String?             @map("email_verify_code")
  emailVerifyExpires            DateTime?           @map("email_verify_expires")
  twoFactorEnabled              Boolean             @default(false) @map("two_factor_enabled")
  twoFactorSecret               String?             @map("two_factor_secret") // TOTP secret, encrypted
  lastLoginAt                   DateTime?           @map("last_login_at")
  deletedAt                     DateTime?           @map("deleted_at")
  isSuperAdmin                  Boolean             @default(false) @map("is_super_admin") // Collabo-team-only global flag
  // ─── Pending subscription captured at onboarding's choose-plan step ───
  // Held here because the Organization (which owns the live billing fields)
  // doesn't exist yet. Copied to Organization on org creation and cleared.
  pendingBillingPlan            BillingPlan?        @map("pending_billing_plan")
  pendingBillingInterval        BillingInterval?    @map("pending_billing_interval")
  pendingExternalCustomerId     String?             @map("pending_external_customer_id")
  pendingExternalSubscriptionId String?             @map("pending_external_subscription_id")
  pendingSubscriptionStatus     SubscriptionStatus? @map("pending_subscription_status")
  pendingCurrentPeriodEnd       DateTime?           @map("pending_current_period_end")
  createdAt                     DateTime            @default(now()) @map("created_at")
  updatedAt                     DateTime            @updatedAt @map("updated_at")

  memberships         OrganizationMember[]
  /// Channels this user personally connected (an influencer's own Instagram).
  ownedChannels       Channel[]            @relation("ChannelOwner")
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  impersonationsMade  ImpersonationLog[]   @relation("ImpersonatorLogs")
  impersonationsOn    ImpersonationLog[]   @relation("ImpersonatedLogs")

  @@index([email])
  @@index([isSuperAdmin])
  @@map("users")
}

/// Audit log of super-admin impersonation sessions.
model ImpersonationLog {
  id           String    @id @default(cuid())
  superAdminId String    @map("super_admin_id")
  targetUserId String    @map("target_user_id")
  targetOrgId  String?   @map("target_org_id")
  startedAt    DateTime  @default(now()) @map("started_at")
  endedAt      DateTime? @map("ended_at")
  ipAddress    String?   @map("ip_address")
  userAgent    String?   @map("user_agent")

  superAdmin User @relation("ImpersonatorLogs", fields: [superAdminId], references: [id])
  targetUser User @relation("ImpersonatedLogs", fields: [targetUserId], references: [id])

  @@index([superAdminId])
  @@index([targetUserId])
  @@index([startedAt])
  @@map("impersonation_logs")
}

model Organization {
  id                     String              @id @default(cuid())
  name                   String // "Acme Store" or "John's Workspace"
  slug                   String              @unique // URL-safe: "acme-store"
  type                   OrganizationType    @default(PERSONAL) // PERSONAL or ORGANIZATION
  logo                   String? // Upload URL
  timezone               String              @default("UTC")
  currency               String              @default("USD")
  industry               String? // e.g., "Fashion", "Electronics"
  website                String? // Business website URL
  billingPlan            BillingPlan         @default(BASIC) @map("billing_plan")
  billingInterval        BillingInterval?    @map("billing_interval")
  externalCustomerId     String?             @map("external_customer_id")
  externalSubscriptionId String?             @unique @map("external_subscription_id")
  billingProvider        BillingProvider?    @map("billing_provider")
  subscriptionStatus     SubscriptionStatus? @map("subscription_status")
  currentPeriodEnd       DateTime?           @map("current_period_end")
  lowStockThreshold      Int                 @default(10) @map("low_stock_threshold")
  gstEnabled             Boolean             @default(false) @map("gst_enabled")
  loyaltyMetric          LoyaltyMetric       @default(ORDERS) @map("loyalty_metric")
  loyaltyBronzeMin       Decimal             @default(1) @map("loyalty_bronze_min") @db.Decimal(12, 2)
  loyaltySilverMin       Decimal             @default(5) @map("loyalty_silver_min") @db.Decimal(12, 2)
  loyaltyGoldMin         Decimal             @default(15) @map("loyalty_gold_min") @db.Decimal(12, 2)
  loyaltyPlatinumMin     Decimal             @default(30) @map("loyalty_platinum_min") @db.Decimal(12, 2)
  onboardingStatus       OnboardingStatus    @default(PENDING) @map("onboarding_status")
  onboardingData         Json?               @map("onboarding_data") @db.JsonB
  metadata               Json?               @db.JsonB
  deletedAt              DateTime?           @map("deleted_at")
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")

  members                OrganizationMember[]
  invites                TeamInvite[]
  channels               Channel[]
  syncLogs               SyncLog[]
  products               Product[]
  customers              Customer[]
  orders                 Order[]
  draftOrders            DraftOrder[]
  inventoryEvents        InventoryEvent[]
  productImportJobs      ProductImportJob[]
  gstins                 OrganizationGstin[]
  invoices               Invoice[]
  stateTaxRates          StateTaxRate[]
  productTypeTaxRates    ProductTypeTaxRate[]
  collections            Collection[]
  collectionTaxOverrides CollectionTaxOverride[]
  whatsappMessages       WhatsAppMessageLog[]
  analyticsSnapshots     AnalyticsSnapshot[]
  rawAnalyticsEvents     RawAnalyticsEvent[]
  settings               OrganizationSettings?
  warehouses             Warehouse[]
  stockLevels            StockLevel[]
  stockReservations      StockReservation[]
  stockReceipts          StockReceipt[]
  pickTasks              PickTask[]
  gstFilings             GstFiling[]
  inwardSupplies         InwardSupply[]

  @@map("organizations")
}

/// Per-org settings, organized by domain in JSONB columns. Each column maps to
/// a Zod schema (see server/src/organization-settings/schemas/*). Adding a new
/// domain (e.g. customerSettings) = one column on this table. Adding a setting
/// within an existing domain = zero migrations — only the schema file changes.
model OrganizationSettings {
  id                String   @id @default(cuid())
  organizationId    String   @unique @map("organization_id")
  productSettings   Json?    @map("product_settings") @db.JsonB
  orderSettings     Json?    @map("order_settings") @db.JsonB
  inventorySettings Json?    @map("inventory_settings") @db.JsonB
  taxSettings       Json?    @map("tax_settings") @db.JsonB
  /// The merchant's own business identity — trading name, address, support
  /// phone / WhatsApp / email, website, logo URL. Read by the package slip's
  /// "From" block; `Organization` has no address or contact columns at all.
  storeProfileSettings Json? @map("store_profile_settings") @db.JsonB
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_settings")
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  role           UserRole @default(AGENT)
  permissions    Json?    @db.JsonB // Fine-grained overrides
  vendorScope    String?  @map("vendor_scope") // For VENDOR role: the Product.vendor value this member is limited to
  isActive       Boolean  @default(true) @map("is_active")
  joinedAt       DateTime @default(now()) @map("joined_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  token     String    @unique
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("password_reset_tokens")
}

model TeamInvite {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  /// Stored lower-cased and trimmed. Acceptance matches on it, so the casing a
  /// colleague happened to type must not decide whether the invite is claimable.
  email          String
  /// What to call the person before they have an account. Optional: an invite
  /// only needs an address to be valid.
  name           String?
  role           UserRole     @default(AGENT)
  vendorScope    String?      @map("vendor_scope") // For VENDOR invites: the Product.vendor value to scope the member to
  token          String       @unique
  status         InviteStatus @default(PENDING)
  invitedBy      String       @map("invited_by")
  expiresAt      DateTime     @map("expires_at") // 7 days
  acceptedAt     DateTime?    @map("accepted_at")
  /// Who accepted. Distinct from the invited email: it is the account that
  /// actually claimed the invite, and it is what links an influencer row to the
  /// Instagram accounts they later connect.
  acceptedUserId String?      @map("accepted_user_id")
  revokedAt      DateTime?    @map("revoked_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// NOTE (not expressible in Prisma): one PENDING invite per organization and
  /// address, as a partial unique index —
  ///   team_invites_one_pending_per_org_email_key
  ///     UNIQUE (organization_id, email) WHERE status = 'PENDING'
  /// Partial because an address may legitimately hold many historical invites
  /// (accepted, expired, revoked) and only the live one must be unique.
  /// See migration 20260911090000_influencer_invitations.
  @@index([organizationId])
  @@index([token])
  @@index([email])
  @@map("team_invites")
}

model Channel {
  id               String          @id @default(cuid())
  organizationId   String          @map("organization_id")
  name             String // "My Shopify Store"
  platform         ChannelPlatform // SHOPIFY, INSTAGRAM, etc.
  status           ChannelStatus   @default(DISCONNECTED) // Connection health
  isEnabled        Boolean         @default(true) @map("is_enabled")
  credentials      Json?           @db.JsonB // Encrypted OAuth tokens
  externalStoreId  String?         @map("external_store_id") // Shopify shop ID
  externalStoreUrl String?         @map("external_store_url") // https://mystore.myshopify.com
  /// The currency this channel trades in — the SHOP's currency for Shopify,
  /// the org's own for manual/in-store. Product prices are bare decimals with
  /// no currency of their own, so this is what says whether a catalogue price
  /// is dollars or rupees. Null until a first order reveals it.
  currency         String?
  lastSyncedAt     DateTime?       @map("last_synced_at")
  syncStatus       SyncStatus      @default(IDLE) @map("sync_status")
  /// When this account was linked. NOT the same as `createdAt`: a row that is
  /// disconnected and later reconnected keeps its original creation date, so
  /// only this column answers "connected since".
  connectedAt      DateTime?       @map("connected_at")
  /// Why the connection is unhealthy, in words a merchant can act on. Set
  /// alongside `status: ERROR` (e.g. a token refresh Meta refused), cleared on
  /// every successful (re)connect.
  lastError        String?         @map("last_error")
  /// The member who personally connected this account, when it belongs to one
  /// rather than to the organization at large.
  ///
  /// This is the whole Organization -> Influencer -> Instagram relationship: an
  /// influencer may only see and manage the channels where this is them, while
  /// owners and admins see every channel in the org. Null for the org's own
  /// channels (Shopify, the manual channel, a WhatsApp number the admin linked).
  ownerUserId      String?         @map("owner_user_id")
  metadata         Json?           @db.JsonB
  pixelIngestToken String?         @unique @map("pixel_ingest_token")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// SetNull, not Cascade: removing a person must not delete the channel and
  /// with it the orders and message logs that hang off it. The row survives as
  /// an org-level channel with no owner.
  ownerUser          User?                @relation("ChannelOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  syncLogs           SyncLog[]
  syncStates         ChannelSyncState[]
  products           Product[]
  customers          Customer[]
  orders             Order[]
  draftOrders        DraftOrder[]
  collections        Collection[]
  whatsappMessages   WhatsAppMessageLog[]
  analyticsSnapshots AnalyticsSnapshot[]
  rawAnalyticsEvents RawAnalyticsEvent[]

  /// ONE ROW = ONE CONNECTED ACCOUNT. An org may hold several rows of the same
  /// platform (many Instagram accounts); the limits are PARTIAL unique indexes,
  /// which Prisma cannot express, so all three live in SQL:
  ///
  ///   channels_one_active_per_org_platform_key  UNIQUE (organization_id, platform)
  ///     WHERE platform = 'MANUAL'
  ///        OR (platform = 'WHATSAPP' AND status <> 'DISCONNECTED')
  ///   channels_platform_external_store_id_key   UNIQUE (platform, external_store_id)
  ///   channels_platform_external_store_url_key  UNIQUE (platform, external_store_url)
  ///                                             WHERE external_store_url IS NOT NULL
  ///
  /// The first caps WhatsApp at one ACTIVE account per org while letting a
  /// disconnected row remain as history (whatsapp_message_logs still reference
  /// it), and keeps MANUAL strictly one-per-org — the invariant
  /// `ensureManualChannel()` depends on.
  ///
  /// The other two stop two organizations — or one org twice — claiming the
  /// same external account. That is both the "an Instagram account connects
  /// once" product rule (external_store_id holds the IG business account id)
  /// and the tenant-isolation guarantee the webhook router depends on, since
  /// HMAC is verified with the app-level secret and so cannot identify a
  /// tenant. Disconnect therefore NULLs external_store_id to release the claim
  /// and copies it to metadata.externalAccountId so the row can be revived.
  ///
  /// See migrations 20260731140000_channel_store_url_unique and
  /// 20260910090000_channel_connected_accounts.
  ///
  /// There is deliberately NO @@unique([organizationId, platform]) — it is what
  /// made multiple Instagram accounts impossible.
  @@index([organizationId, platform])
  @@index([organizationId])
  /// Drives "the channels this influencer connected" on every page load.
  @@index([organizationId, ownerUserId])
  @@map("channels")
}

/// Per-entity sync bookkeeping for a channel: where the last successful run of
/// THAT entity got to, and whether the merchant wants it synced at all.
///
/// Replaces the single channel-level `Channel.lastSyncedAt` as the sync filter.
/// That watermark only advanced when EVERY entity succeeded, so one failing
/// entity forced a full rescan of all the others on every BullMQ retry - the
/// amplifier that turned an orders failure into a store-wide rate-limit event.
///
/// One row per (channel, direction, entity):
///   direction 'pull' -> products | orders | customers | inventory | collections
///   direction 'push' -> orders | products | drafts
/// `push` rows use only `enabled`; the watermark columns stay null for them.
model ChannelSyncState {
  id           String    @id @default(cuid())
  channelId    String    @map("channel_id")
  direction    String    @default("pull")
  entityType   String    @map("entity_type")
  /// Merchant's per-entity toggle. Controls the BULK pass only - real-time
  /// webhooks keep flowing regardless, and disabling never deletes data.
  enabled      Boolean   @default(true)
  /// Start time of the last run of this entity that completed cleanly.
  /// Compared against Shopify's `updated_at`, so it is deliberately rewound by
  /// SYNC_WATERMARK_SKEW_MS to absorb clock drift between the two servers.
  watermark    DateTime?
  /// False until this entity has completed a first full/windowed backfill.
  /// Drives the choice between the initial window and the incremental filter.
  backfillDone Boolean   @default(false) @map("backfill_done")
  /// The floor the initial backfill used, recorded so it stays auditable
  /// (orders are windowed to SHOPIFY_INITIAL_ORDER_WINDOW_DAYS on first pull).
  windowStart  DateTime? @map("window_start")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, direction, entityType])
  @@index([channelId])
  @@map("channel_sync_states")
}

model SyncLog {
  id               String     @id @default(cuid())
  organizationId   String     @map("organization_id")
  channelId        String     @map("channel_id")
  status           SyncStatus
  entityType       String     @map("entity_type") // "products" | "orders" | "customers"
  recordsProcessed Int        @default(0) @map("records_processed")
  recordsFailed    Int        @default(0) @map("records_failed")
  totalEstimated   Int?       @map("total_estimated") // For progress bar
  cursor           String? // Resume point for pagination
  errorMessage     String?    @map("error_message")
  errorDetails     Json?      @map("error_details") @db.JsonB
  startedAt        DateTime   @map("started_at")
  completedAt      DateTime?  @map("completed_at")
  createdAt        DateTime   @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel      Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([channelId])
  @@index([createdAt])
  @@map("sync_logs")
}

model Product {
  id                String        @id @default(cuid())
  organizationId    String        @map("organization_id")
  channelId         String        @map("channel_id")
  externalId        String        @map("external_id") // Shopify product ID
  title             String // "Blue T-Shirt"
  bodyHtml          String?       @map("body_html") // Product description HTML
  vendor            String? // "Nike" (built-in Shopify Vendor field)
  vendorKey         String?       @map("vendor_key") // vendor metafield value — primary vendor match key
  productType       String?       @map("product_type") // "T-Shirts"
  status            ProductStatus @default(ACTIVE)
  tags              String[]      @default([]) // ["summer", "sale"]
  hsnCode           String?       @map("hsn_code") // HSN/SAC code for GST (e.g. "6109")
  /// GSTR-1 Table 12 requires a unit of quantity code (NOS, PCS, KGS, MTR...).
  /// Null falls back to the org default in taxSettings. NOT ProductVariant.weightUnit,
  /// which is a Shopify shipping weight and a different vocabulary entirely.
  unitOfMeasure     String?       @map("unit_of_measure")
  /// Nil-rated / exempt / non-GST cannot be inferred from a 0% rate, so they are
  /// classified here. ZERO_RATED is never set here — it is derived from an export
  /// place of supply at invoice time.
  supplyType        GstSupplyType @default(TAXABLE) @map("supply_type")
  gstRate           Decimal?      @map("gst_rate") @db.Decimal(5, 2) // Default GST rate (e.g. 18.00)
  options           Json?         @db.JsonB // [{name:"Size", values:["S","M","L"]}]
  publishedAt       DateTime?     @map("published_at")
  metadata          Json?         @db.JsonB
  deletedAt         DateTime?     @map("deleted_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  externalCreatedAt DateTime?     @map("external_created_at") // When created in Shopify
  externalUpdatedAt DateTime?     @map("external_updated_at")

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel            Channel             @relation(fields: [channelId], references: [id], onDelete: Cascade)
  variants           ProductVariant[]
  images             ProductImage[]
  productCollections ProductCollection[]

  @@unique([channelId, externalId])
  @@index([organizationId])
  @@index([channelId])
  @@index([status])
  @@index([vendor])
  @@index([vendorKey])
  @@index([productType])
  @@index([createdAt])
  @@map("products")
}

model ProductVariant {
  id                            String         @id @default(cuid())
  productId                     String         @map("product_id")
  // Denormalized from product.organizationId (scalar only, no relation — org
  // scoping stays transitive via product). Exists for the inventory hot paths:
  // barcode/SKU scan lookup and org-scoped duplicate detection. Nullable until
  // the NOT NULL flip migration lands after all writers are verified; app code
  // must set it on every variant create.
  organizationId                String?        @map("organization_id")
  externalId                    String         @map("external_id") // Shopify variant ID
  title                         String // "Small / Red"
  sku                           String? // "BTS-SM-RD"
  barcode                       String?
  // Provenance of `barcode`. Answers three questions no other field can:
  // which barcodes may we regenerate (GENERATED only), which may a Shopify
  // pull overwrite (anything but GENERATED — see shopify-sync upsert), and
  // which may be pushed to Shopify (GENERATED gated behind
  // inventorySettings.pushGeneratedBarcodes). NULL on legacy rows the backfill
  // could not classify; treat NULL as MANUAL.
  barcodeSource                 BarcodeSource? @map("barcode_source")
  price                         Decimal        @db.Decimal(12, 2) // $29.99
  compareAtPrice                Decimal?       @map("compare_at_price") @db.Decimal(12, 2) // $39.99 (original price)
  cost                          Decimal?       @db.Decimal(12, 2) // Cost per item (COGS) — drives margin display
  inventoryItemId               String?        @map("inventory_item_id")
  inventoryQuantity             Int            @default(0) @map("inventory_quantity")
  weight                        Decimal?       @db.Decimal(10, 4)
  weightUnit                    String?        @map("weight_unit") // "kg", "lb"
  option1                       String? // "Small"
  option2                       String? // "Red"
  option3                       String?
  position                      Int            @default(1)
  requiresShipping              Boolean        @default(true) @map("requires_shipping")
  taxable                       Boolean        @default(true)
  // Phase 2 inventory + customs fields
  trackQuantity                 Boolean        @default(true) @map("track_quantity")
  continueSellingWhenOutOfStock Boolean        @default(false) @map("continue_selling_when_out_of_stock")
  hsCode                        String?        @map("hs_code") // Customs HS code, e.g. "6109.10"
  countryOfOrigin               String?        @map("country_of_origin") // ISO-3166 alpha-2
  // GST override for THIS variant only. Null inherits the Product's value —
  // the product-level fields stay the default for every variant, and a
  // variant sets these only when it is classified differently (a bundle
  // listing mixing 5% and 18% goods, say). Resolved per line at invoice /
  // order time; see gst/line-tax-classification.util.ts and TaxResolverService.
  hsnCode                       String?        @map("hsn_code")
  gstRate                       Decimal?       @map("gst_rate") @db.Decimal(5, 2)
  unitOfMeasure                 String?        @map("unit_of_measure")
  supplyType                    GstSupplyType? @map("supply_type")
  imageId                       String?        @map("image_id") // Variant-specific image (FK → ProductImage)
  createdAt                     DateTime       @default(now()) @map("created_at")
  updatedAt                     DateTime       @updatedAt @map("updated_at")

  product             Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  image               ProductImage?        @relation("VariantImage", fields: [imageId], references: [id], onDelete: SetNull)
  lineItems           OrderLineItem[]
  draftOrderLineItems DraftOrderLineItem[]
  stockLevels         StockLevel[]

  @@unique([productId, externalId])
  @@index([productId])
  @@index([sku])
  @@index([inventoryQuantity])
  @@index([inventoryItemId])
  @@index([imageId])
  @@index([organizationId, sku])
  @@index([organizationId, barcode])
  @@map("product_variants")
}

model ProductImage {
  id         String   @id @default(cuid())
  productId  String   @map("product_id")
  externalId String   @map("external_id")
  src        String // Image URL
  alt        String?
  position   Int      @default(1)
  width      Int?
  height     Int?
  createdAt  DateTime @default(now()) @map("created_at")

  product  Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  variants ProductVariant[] @relation("VariantImage")

  @@unique([productId, externalId])
  @@index([productId])
  @@map("product_images")
}

model Customer {
  id               String        @id @default(cuid())
  organizationId   String        @map("organization_id")
  channelId        String        @map("channel_id")
  externalId       String        @map("external_id") // Shopify customer ID
  email            String?
  firstName        String?       @map("first_name")
  lastName         String?       @map("last_name")
  phone            String?
  state            CustomerState @default(ENABLED)
  verifiedEmail    Boolean       @default(false) @map("verified_email")
  acceptsMarketing Boolean       @default(false) @map("accepts_marketing")
  ordersCount      Int           @default(0) @map("orders_count")
  totalSpent       Decimal       @default(0) @map("total_spent") @db.Decimal(12, 2)
  tags             String[]      @default([])
  note             String? // From Shopify
  addresses        Json?         @db.JsonB // [{address1, city, province, country, zip}]
  defaultAddress   Json?         @map("default_address") @db.JsonB

  // CRM-specific (not from Shopify)
  vipLevel      VipLevel @default(NONE) @map("vip_level")
  internalNotes String?  @map("internal_notes") // Team notes
  segments      String[] @default([]) // ["high-value", "repeat"]

  // GST fields
  gstin            String? // Customer's GSTIN for B2B
  billingStateCode String? @map("billing_state_code") // 2-digit Indian state code
  billingStateName String? @map("billing_state_name") // Full state name

  metadata          Json?     @db.JsonB
  deletedAt         DateTime? @map("deleted_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  externalCreatedAt DateTime? @map("external_created_at")
  externalUpdatedAt DateTime? @map("external_updated_at")

  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel          Channel               @relation(fields: [channelId], references: [id], onDelete: Cascade)
  orders           Order[]
  draftOrders      DraftOrder[]
  activityLogs     CustomerActivityLog[]
  whatsappMessages WhatsAppMessageLog[]

  @@unique([channelId, externalId])
  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([channelId])
  @@index([email])
  @@index([vipLevel])
  @@index([totalSpent])
  @@index([createdAt])
  @@map("customers")
}

model CustomerActivityLog {
  id          String   @id @default(cuid())
  customerId  String   @map("customer_id")
  actorId     String?  @map("actor_id") // User who did it (null = system)
  action      String // "note_added", "vip_changed", "tag_added"
  description String? // "VIP changed from NONE to GOLD"
  oldValue    String?  @map("old_value")
  newValue    String?  @map("new_value")
  metadata    Json?    @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([createdAt])
  @@map("customer_activity_logs")
}

model Order {
  id                  String                 @id @default(cuid())
  organizationId      String                 @map("organization_id")
  channelId           String                 @map("channel_id")
  customerId          String?                @map("customer_id") // Nullable: guest orders
  externalId          String                 @map("external_id") // Shopify order ID
  orderNumber         Int                    @map("order_number") // 1001, 1002...
  name                String // "#1001"
  financialStatus     OrderFinancialStatus   @map("financial_status")
  fulfillmentStatus   OrderFulfillmentStatus @default(UNFULFILLED) @map("fulfillment_status")
  currency            String                 @default("USD")
  /// Units of `baseCurrency` per 1 unit of `currency`, as at the order's own
  /// date — NOT today's rate. A report for last July must return the same
  /// figure every time it is run, and must still agree with a GST return
  /// already filed; converting live would move both every day.
  ///
  /// 1 when `currency` already is the org currency. NULL means "not yet
  /// resolved" (rate provider unreachable, or an order predating the
  /// backfill): callers must treat NULL as unknown and exclude it, never
  /// coerce it to 1, which would silently book $2,545 as ₹2,545.
  exchangeRate        Decimal?               @map("exchange_rate") @db.Decimal(18, 8)
  /// What `exchangeRate` converts INTO — the org currency at the time it was
  /// captured. Stored so that changing the org currency later invalidates
  /// these rates loudly instead of quietly reinterpreting them.
  baseCurrency        String?                @map("base_currency")
  subtotalPrice       Decimal                @map("subtotal_price") @db.Decimal(12, 2)
  totalPrice          Decimal                @map("total_price") @db.Decimal(12, 2)
  totalTax            Decimal                @default(0) @map("total_tax") @db.Decimal(12, 2)
  totalDiscounts      Decimal                @default(0) @map("total_discounts") @db.Decimal(12, 2)
  totalShippingPrice  Decimal                @default(0) @map("total_shipping_price") @db.Decimal(12, 2)
  shippingAddress     Json?                  @map("shipping_address") @db.JsonB
  billingAddress      Json?                  @map("billing_address") @db.JsonB
  note                String?
  tags                String[]               @default([])
  cancelReason        OrderCancelReason?     @map("cancel_reason")
  cancelledAt         DateTime?              @map("cancelled_at")
  closedAt            DateTime?              @map("closed_at")
  /// GST place of supply resolved AT THE TIME THE ORDER WAS TAXED, plus the
  /// resulting CGST+SGST vs IGST split. Persisted so the invoice reports what
  /// the customer was actually charged instead of re-deriving it later from
  /// data that may have changed (the two derivations previously disagreed and
  /// could produce a different tax head and a different amount). Null for
  /// orders created before this was introduced, and for non-GST orgs.
  placeOfSupplyCode   String?                @map("place_of_supply_code")
  gstType             GstType?               @map("gst_type")
  /// Warehouse the goods left from. Stamped FIRST-WRITE-ONLY by the offline
  /// order DTO, the Shopify fulfilment location, or the fulfillment-order
  /// assignment read before auto-invoicing; never null-overwritten by a later
  /// sync. Snapshotted onto the invoice as "Dispatch From".
  dispatchWarehouseId String?                @map("dispatch_warehouse_id")

  /// What the SALES CHANNEL says it charged in tax, as opposed to what the CRM
  /// computes. Nullable with no default on purpose: NULL means "never told"
  /// (offline orders, and every order predating this), while 0 means "the
  /// channel told us zero". The invoice reconciliation depends on that
  /// distinction, so do not give these a default.
  taxesIncluded            Boolean? @map("taxes_included")
  channelShippingTaxAmount Decimal? @map("channel_shipping_tax_amount") @db.Decimal(12, 2)
  channelShippingTaxLines  Json?    @map("channel_shipping_tax_lines") @db.JsonB

  /// Last auto-invoicing failure for this order. `maybeAutoInvoice` swallows
  /// errors by design (a failed invoice must not fail the webhook), so without
  /// these an org with GST off or no GSTIN accrued paid, uninvoiced orders
  /// with no signal. Cleared on any successful issue.
  invoiceError      String?   @map("invoice_error")
  invoiceErrorAt    DateTime? @map("invoice_error_at")
  metadata          Json?     @db.JsonB
  deletedAt         DateTime? @map("deleted_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  externalCreatedAt DateTime? @map("external_created_at")
  externalUpdatedAt DateTime? @map("external_updated_at")

  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel           Channel              @relation(fields: [channelId], references: [id], onDelete: Cascade)
  customer          Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  dispatchWarehouse Warehouse?           @relation("OrderDispatchWarehouse", fields: [dispatchWarehouseId], references: [id], onDelete: SetNull)
  lineItems         OrderLineItem[]
  fulfillments      OrderFulfillment[]
  refunds           OrderRefund[]
  timeline          OrderTimelineEvent[]
  invoices          Invoice[]
  whatsappMessages  WhatsAppMessageLog[]
  /// Back-relation for DraftOrder.completedOrderId. A finalized order may
  /// originate from a draft; this lets us link "this order was created from
  /// draft <name>" in the UI.
  draftOrderOrigin  DraftOrder?          @relation("DraftOrderCompletedOrder")

  @@unique([channelId, externalId])
  // NOTE (not expressible in Prisma): a PARTIAL unique index
  //   orders_channel_id_order_number_manual_key
  //     ON (channel_id, order_number) WHERE external_id LIKE 'manual\_%'
  // guards the read-max-then-increment numbering of MANUAL (offline) orders —
  // see migration 20260729120000_manual_order_number_unique. It is deliberately
  // NOT a full unique: Shopify assigns its own order numbers and can re-issue
  // them (e.g. a dev store's test-data wipe resets its counter — observed in
  // production data), so Shopify-channel rows must stay exempt.
  @@index([organizationId])
  @@index([channelId])
  @@index([customerId])
  @@index([dispatchWarehouseId])
  @@index([financialStatus])
  @@index([fulfillmentStatus])
  @@index([orderNumber])
  @@index([createdAt])
  @@index([organizationId, financialStatus])
  // Finding orders that still need an FX rate, and grouping totals per currency.
  @@index([organizationId, currency])
  @@index([organizationId, fulfillmentStatus])
  @@map("orders")
}

model OrderLineItem {
  id                String   @id @default(cuid())
  orderId           String   @map("order_id")
  variantId         String?  @map("variant_id")
  externalId        String   @map("external_id")
  externalProductId String?  @map("external_product_id")
  externalVariantId String?  @map("external_variant_id")
  title             String // Product name snapshot
  variantTitle      String?  @map("variant_title") // "Small / Red"
  sku               String?
  vendor            String? // Snapshot of the line's vendor (Product.vendor) — drives vendor-scoped access
  quantity          Int
  price             Decimal  @db.Decimal(12, 2) // Per unit
  totalDiscount     Decimal  @default(0) @map("total_discount") @db.Decimal(12, 2)
  /// Units shipped so far, 0..quantity. `fulfillmentStatus` alone cannot express
  /// a partial shipment: Shopify accepts a per-line quantity on fulfillmentCreate,
  /// so fulfilling 2 of 5 used to flip the whole line to 'fulfilled' and report
  /// the order complete while 3 units were still unshipped.
  fulfilledQuantity Int      @default(0) @map("fulfilled_quantity")
  fulfillmentStatus String?  @map("fulfillment_status")
  requiresShipping  Boolean  @default(true) @map("requires_shipping")
  taxable           Boolean  @default(true)
  /// Per-line tax as reported by the sales channel. NULL when the channel did
  /// not tell us (see Order.taxesIncluded) — NOT the same as zero.
  channelTaxAmount  Decimal? @map("channel_tax_amount") @db.Decimal(12, 2)
  channelTaxLines   Json?    @map("channel_tax_lines") @db.JsonB
  properties        Json?    @db.JsonB
  createdAt         DateTime @default(now()) @map("created_at")

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([orderId, externalId])
  @@index([orderId])
  @@index([variantId])
  @@index([vendor])
  @@map("order_line_items")
}

model OrderFulfillment {
  id              String    @id @default(cuid())
  orderId         String    @map("order_id")
  externalId      String?   @map("external_id")
  status          String    @default("pending")
  trackingNumber  String?   @map("tracking_number")
  trackingUrl     String?   @map("tracking_url")
  trackingCompany String?   @map("tracking_company")
  shippedAt       DateTime? @map("shipped_at")
  deliveredAt     DateTime? @map("delivered_at")
  metadata        Json?     @db.JsonB
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, externalId])
  @@index([orderId])
  @@map("order_fulfillments")
}

model OrderRefund {
  id          String    @id @default(cuid())
  orderId     String    @map("order_id")
  externalId  String    @map("external_id")
  amount      Decimal   @db.Decimal(12, 2)
  currency    String    @default("USD")
  reason      String?
  note        String?
  lineItems   Json?     @map("line_items") @db.JsonB
  /// Tax actually refunded, as the channel reported it. NULL means the payload
  /// never told us — NOT the same as a tax-free refund. Without these a
  /// refunded sale stayed 100% in declared liability for ever.
  totalTax    Decimal?  @map("total_tax") @db.Decimal(12, 2)
  shippingTax Decimal?  @map("shipping_tax") @db.Decimal(12, 2)
  taxLines    Json?     @map("tax_lines") @db.JsonB
  /// Shopify order_adjustments — discounts and shipping written off after the
  /// fact. Ignoring them understates the credit note.
  adjustments Json?     @db.JsonB
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, externalId])
  @@index([orderId])
  @@map("order_refunds")
}

model OrderTimelineEvent {
  id        String   @id @default(cuid())
  orderId   String   @map("order_id")
  actorId   String?  @map("actor_id")
  action    String // "created", "paid", "fulfilled", "refunded"
  message   String // "Order marked as fulfilled"
  metadata  Json?    @db.JsonB
  createdAt DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
  @@map("order_timeline_events")
}

/// Draft orders — in-progress / quote-style orders that haven't been
/// finalized yet. Separate table from `Order` so the state machines don't
/// collide. Drafts can be edited freely; on `complete`, the draft is
/// converted to a real Order and locked (status flips to COMPLETED with
/// `completedOrderId` linking to the new row).
///
/// SHOPIFY-connected workspaces also mirror drafts to Shopify via the
/// `draftOrderCreate` / `draftOrderUpdate` mutations so the merchant gets
/// Shopify's hosted invoice email + checkout link (`draftOrderInvoiceSend`).
/// MANUAL workspaces use the same row but skip the Shopify round-trip.
model DraftOrder {
  id                 String           @id @default(cuid())
  organizationId     String           @map("organization_id")
  channelId          String           @map("channel_id")
  customerId         String?          @map("customer_id") // Nullable: anonymous draft
  /// Numeric suffix of Shopify DraftOrder GID for SHOPIFY-mirrored drafts; null for MANUAL.
  externalId         String?          @map("external_id")
  /// Shopify-assigned name (e.g. "D1234"). Null until SHOPIFY mirror lands.
  name               String?
  status             DraftOrderStatus @default(OPEN)
  customerEmail      String?          @map("customer_email")
  note               String?
  tags               String[]         @default([])
  currency           String           @default("USD")
  subtotalPrice      Decimal          @default(0) @map("subtotal_price") @db.Decimal(12, 2)
  totalPrice         Decimal          @default(0) @map("total_price") @db.Decimal(12, 2)
  totalTax           Decimal          @default(0) @map("total_tax") @db.Decimal(12, 2)
  totalDiscounts     Decimal          @default(0) @map("total_discounts") @db.Decimal(12, 2)
  totalShippingPrice Decimal          @default(0) @map("total_shipping_price") @db.Decimal(12, 2)
  shippingAddress    Json?            @map("shipping_address") @db.JsonB
  billingAddress     Json?            @map("billing_address") @db.JsonB
  /// Shopify-hosted checkout URL after invoice send. Customer pays here.
  invoiceUrl         String?          @map("invoice_url")
  invoiceSentAt      DateTime?        @map("invoice_sent_at")
  /// Set once the draft is converted to a real Order.
  completedAt        DateTime?        @map("completed_at")
  completedOrderId   String?          @unique @map("completed_order_id")
  metadata           Json?            @db.JsonB
  deletedAt          DateTime?        @map("deleted_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  externalCreatedAt  DateTime?        @map("external_created_at")
  externalUpdatedAt  DateTime?        @map("external_updated_at")

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel        Channel              @relation(fields: [channelId], references: [id], onDelete: Cascade)
  customer       Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lineItems      DraftOrderLineItem[]
  completedOrder Order?               @relation("DraftOrderCompletedOrder", fields: [completedOrderId], references: [id])

  @@unique([channelId, externalId])
  @@index([organizationId])
  @@index([channelId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([organizationId, status])
  @@map("draft_orders")
}

model DraftOrderLineItem {
  id               String   @id @default(cuid())
  draftOrderId     String   @map("draft_order_id")
  variantId        String?  @map("variant_id")
  externalId       String?  @map("external_id") // Shopify line item gid (numeric suffix)
  title            String
  variantTitle     String?  @map("variant_title")
  sku              String?
  quantity         Int
  /// Unit price snapshot at the time of draft creation.
  price            Decimal  @db.Decimal(12, 2)
  totalDiscount    Decimal  @default(0) @map("total_discount") @db.Decimal(12, 2)
  taxable          Boolean  @default(true)
  requiresShipping Boolean  @default(true) @map("requires_shipping")
  properties       Json?    @db.JsonB
  createdAt        DateTime @default(now()) @map("created_at")

  draftOrder DraftOrder      @relation(fields: [draftOrderId], references: [id], onDelete: Cascade)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([draftOrderId])
  @@index([variantId])
  @@map("draft_order_line_items")
}

// The inventory movement ledger (append-only audit). One row = one atomic
// transition of `changeAmount` units between buckets:
//   fromBucket NULL → stock entering the system (receipt, return, migration seed)
//   toBucket   NULL → stock leaving the system (dispatch, write-off)
// Legacy rows (pre-warehousing) have NULL from/to buckets and keep meaning
// "variant aggregate quantity changed". variantId is deliberately NOT a FK —
// the audit trail must survive variant deletion; skuSnapshot preserves identity.
model InventoryEvent {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  variantId      String       @map("variant_id")
  quantityBefore Int          @map("quantity_before")
  quantityAfter  Int          @map("quantity_after")
  changeAmount   Int          @map("change_amount") // +5 or -3
  reason         String // "sync", "sale", "restock", "adjustment", "return", "receipt", "migration", "shopify_drift", "count", "damage", "order_return"
  referenceType  String?      @map("reference_type") // "order" | "refund" | "manual" | "receipt" | "pick_task" | "webhook"
  referenceId    String?      @map("reference_id")
  warehouseId    String?      @map("warehouse_id")
  locationId     String?      @map("location_id") // plain string snapshot, no FK (audit survives location changes)
  fromBucket     StockBucket? @map("from_bucket")
  toBucket       StockBucket? @map("to_bucket")
  // Units this movement touched (always positive; direction = from/to buckets).
  // Needed because changeAmount is the signed delta to the SELLABLE quantity,
  // which is 0 for bucket-to-bucket transfers. NULL on legacy rows.
  movedQty       Int?         @map("moved_qty")
  skuSnapshot    String?      @map("sku_snapshot") // variant SKU at event time; survives variant deletion
  actorId        String?      @map("actor_id") // userId that caused the movement, when known
  // Dedup key for webhook/BullMQ retries, e.g. "shopify:order:123:reserve".
  // SQL-only partial unique: (organization_id, idempotency_key) WHERE idempotency_key IS NOT NULL
  idempotencyKey String?      @map("idempotency_key")
  createdAt      DateTime     @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse    Warehouse?   @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([variantId])
  @@index([createdAt])
  @@index([organizationId, warehouseId, createdAt])
  @@map("inventory_events")
}

// ============================================================
// Inventory V1 — warehousing (org-gated via inventorySettings.warehousingEnabled)
// ============================================================

model Warehouse {
  id                String   @id @default(cuid())
  organizationId    String   @map("organization_id")
  name              String // "Main Warehouse"
  code              String // "WH1" — prefix of location fullCodes
  // Numeric Shopify location id this warehouse mirrors (V1: at most one mapped
  // warehouse per org — seeded from Channel.metadata.shopifyLocationId).
  shopifyLocationId String?  @map("shopify_location_id")
  // Canonical address keys ({ address1, address2, city, zip, province }) plus
  // `stateCode` (GST 2-digit) so both `extractStateFromAddress` (server) and
  // `readAddress` (client) can read it. Filled once from Shopify when absent,
  // then the merchant's to edit; the sync never overwrites it.
  address           Json?    @db.JsonB
  /// Which GST registration this warehouse operates under — an *additional
  /// place of business* (APOB) of that GSTIN. Null = not linked. The state of
  /// `address` must match the registration's state (a place of business in
  /// another state needs its own GSTIN); enforced in WarehouseService.
  gstinId           String?  @map("gstin_id")
  /// Merchant's confirmation that this APOB has been declared on the GST
  /// portal — a registration amendment the app cannot perform for them.
  apobDeclared      Boolean  @default(false) @map("apob_declared")
  isDefault         Boolean  @default(false) @map("is_default")
  isActive          Boolean  @default(true) @map("is_active") // deactivate, never hard-delete (ledger references)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locations        WarehouseLocation[]
  stockLevels      StockLevel[]
  reservations     StockReservation[]
  receipts         StockReceipt[]
  pickTasks        PickTask[]
  inventoryEvents  InventoryEvent[]
  gstin            OrganizationGstin?  @relation(fields: [gstinId], references: [id], onDelete: SetNull)
  dispatchOrders   Order[]             @relation("OrderDispatchWarehouse")
  dispatchInvoices Invoice[]           @relation("InvoiceDispatchWarehouse")

  // SQL-only partial uniques:
  //   (organization_id) WHERE is_default          — one default per org
  //   (organization_id, shopify_location_id) WHERE shopify_location_id IS NOT NULL
  //     — the Shopify-location mapping is an identity the location sync
  //       re-resolves on every run; a duplicate would split one location's
  //       stock across two warehouses. See 20260818090000.
  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([gstinId])
  @@map("warehouses")
}

// Self-referencing location tree: Zone → Rack → Shelf → Bin at any depth.
// fullCode is the materialized, scannable identity ("WH1-A01-S02-B03").
model WarehouseLocation {
  id          String       @id @default(cuid())
  warehouseId String       @map("warehouse_id")
  parentId    String?      @map("parent_id")
  type        LocationType
  code        String // segment, e.g. "A01"
  fullCode    String       @map("full_code") // "WH1-A01-S02-B03"
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")

  warehouse        Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  parent           WarehouseLocation?  @relation("LocationTree", fields: [parentId], references: [id], onDelete: Cascade)
  children         WarehouseLocation[] @relation("LocationTree")
  stockLevels      StockLevel[]        @relation("StockLevelLocation")
  defaultForLevels StockLevel[]        @relation("StockLevelDefaultLocation")

  @@unique([warehouseId, fullCode])
  @@index([warehouseId, type])
  @@index([parentId])
  @@map("warehouse_locations")
}

// One row per variant × warehouse (locationId NULL in V1 = warehouse-level
// tracking). Bin-level rows (locationId set) are V2 — same table, no schema
// change; the two SQL partial uniques enforce both shapes.
// SQL-only: on_hand INTEGER GENERATED ALWAYS AS (available+reserved+qc+damaged) STORED,
// CHECKs reserved>=0, qc>=0, damaged>=0. `available` may go negative ONLY via
// the Shopify order-mirror path (oversold — surfaced as an alert, not an error).
model StockLevel {
  id                String   @id @default(cuid())
  organizationId    String   @map("organization_id") // denormalized for org-scoped listing
  variantId         String   @map("variant_id")
  warehouseId       String   @map("warehouse_id")
  locationId        String?  @map("location_id")
  available         Int      @default(0)
  reserved          Int      @default(0)
  qc                Int      @default(0)
  damaged           Int      @default(0)
  // Informational putaway/pick hint shown on pick lists in V1 (true bin-level
  // quantities are V2).
  defaultLocationId String?  @map("default_location_id")
  updatedAt         DateTime @updatedAt @map("updated_at")

  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  variant         ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouse       Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  location        WarehouseLocation? @relation("StockLevelLocation", fields: [locationId], references: [id], onDelete: SetNull)
  defaultLocation WarehouseLocation? @relation("StockLevelDefaultLocation", fields: [defaultLocationId], references: [id], onDelete: SetNull)

  // SQL-only partial uniques:
  //   (variant_id, warehouse_id) WHERE location_id IS NULL
  //   (variant_id, warehouse_id, location_id) WHERE location_id IS NOT NULL
  @@index([organizationId])
  @@index([variantId])
  @@index([warehouseId])
  @@index([organizationId, available])
  @@map("stock_levels")
}

// Itemization behind StockLevel.reserved: which order line holds how much, at
// which warehouse. The bucket is the aggregate; these rows let cancel /
// partial-dispatch release exactly the right amount. orderId/orderLineItemId
// are plain strings (no FK) — operational rows managed by the reserve/release
// flows, decoupled from order line-item reconcile pruning.
model StockReservation {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")
  orderId         String   @map("order_id")
  orderLineItemId String   @map("order_line_item_id")
  variantId       String   @map("variant_id")
  warehouseId     String   @map("warehouse_id")
  quantity        Int // remaining reserved; decremented on dispatch
  status          String // ACTIVE | RELEASED | CONSUMED
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  // SQL-only partial unique: (order_line_item_id, warehouse_id) WHERE status = 'ACTIVE'
  @@index([orderId])
  @@index([variantId, status])
  @@index([organizationId])
  @@map("stock_reservations")
}

// Goods Received Note. vendorName reuses the existing vendor-string convention
// (no Supplier model in V1); refNumber is a free-text vendor invoice / PO ref.
model StockReceipt {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  warehouseId    String    @map("warehouse_id")
  receiptNumber  String    @map("receipt_number") // "GRN-000042", org-scoped sequence
  vendorName     String?   @map("vendor_name")
  refNumber      String?   @map("ref_number")
  status         String // DRAFT | RECEIVED | COMPLETED
  notes          String?
  receivedById   String?   @map("received_by_id")
  receivedAt     DateTime? @map("received_at")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse    Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  lines        StockReceiptLine[]

  @@unique([organizationId, receiptNumber])
  @@index([organizationId])
  @@index([warehouseId])
  @@index([status])
  @@map("stock_receipts")
}

model StockReceiptLine {
  id                String   @id @default(cuid())
  receiptId         String   @map("receipt_id")
  variantId         String   @map("variant_id") // plain string — receipt history survives variant deletion
  qtyReceived       Int      @map("qty_received")
  qtyAccepted       Int      @default(0) @map("qty_accepted")
  qtyRejected       Int      @default(0) @map("qty_rejected") // → DAMAGED bucket
  unitCost          Decimal? @map("unit_cost") @db.Decimal(12, 2)
  putawayLocationId String?  @map("putaway_location_id") // sets StockLevel.defaultLocationId
  createdAt         DateTime @default(now()) @map("created_at")

  receipt StockReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
  @@index([variantId])
  @@map("stock_receipt_lines")
}

// One fulfillment task per order (SQL partial unique allows a new task once the
// prior one is DISPATCHED/CANCELLED — partial-pick remainders). Stock stays
// RESERVED through PICKED and PACKED; it exits (RESERVED→NULL) at dispatch.
model PickTask {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  orderId        String    @map("order_id") // plain string; partial unique in SQL
  warehouseId    String    @map("warehouse_id")
  status         String // PENDING | PICKING | PICKED | PACKED | DISPATCHED | CANCELLED
  assigneeId     String?   @map("assignee_id")
  startedAt      DateTime? @map("started_at")
  packedAt       DateTime? @map("packed_at")
  dispatchedAt   DateTime? @map("dispatched_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse    Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  lines        PickTaskLine[]

  // SQL-only partial unique: (order_id) WHERE status NOT IN ('DISPATCHED','CANCELLED')
  @@index([organizationId, status])
  @@index([orderId])
  @@map("pick_tasks")
}

model PickTaskLine {
  id              String  @id @default(cuid())
  pickTaskId      String  @map("pick_task_id")
  orderLineItemId String  @map("order_line_item_id")
  variantId       String  @map("variant_id")
  qtyRequired     Int     @map("qty_required")
  qtyPicked       Int     @default(0) @map("qty_picked") // persisted per scan — station crash loses nothing
  locationCode    String? @map("location_code") // snapshot of defaultLocation.fullCode at task creation

  pickTask PickTask @relation(fields: [pickTaskId], references: [id], onDelete: Cascade)

  @@index([pickTaskId])
  @@index([variantId])
  @@map("pick_task_lines")
}

// Tracks Shopify-format CSV import jobs through their preview → run lifecycle.
// previewRows holds the first ~10 parsed rows so the UI can confirm before
// committing; errors holds row-level failures for the post-run report.
model ProductImportJob {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  userId         String?   @map("user_id")
  status         String // PARSING | PREVIEW | RUNNING | COMPLETED | FAILED
  filename       String
  totalRows      Int       @default(0) @map("total_rows")
  processedRows  Int       @default(0) @map("processed_rows")
  createdCount   Int       @default(0) @map("created_count")
  updatedCount   Int       @default(0) @map("updated_count")
  errorCount     Int       @default(0) @map("error_count")
  errors         Json?     @db.JsonB // [{ row, message }]
  previewRows    Json?     @map("preview_rows") @db.JsonB
  createdAt      DateTime  @default(now()) @map("created_at")
  completedAt    DateTime? @map("completed_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([createdAt])
  @@map("product_import_jobs")
}

// ─── GST Models ──────────────────────────────────────────────────────────────

model OrganizationGstin {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  gstin          String // 15-char GSTIN e.g. "27AABCU9603R1ZM"
  legalName      String   @map("legal_name") // Registered legal name
  tradeName      String?  @map("trade_name") // Trade/brand name
  stateCode      String   @map("state_code") // 2-digit Indian state code e.g. "27"
  stateName      String   @map("state_name") // Full name e.g. "Maharashtra"
  // Canonical address keys — the same shape every other address blob in the
  // system uses, so `client/app/lib/address.ts readAddress()` can render it:
  // { address1, address2, city, zip, province }. Snapshotted onto
  // Invoice.sellerAddress at issue time; a GST tax invoice must carry the
  // supplier's address.
  address        Json?    @db.JsonB
  isDefault      Boolean  @default(false) @map("is_default")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices     Invoice[]
  warehouses   Warehouse[]

  @@unique([organizationId, gstin])
  @@index([organizationId])
  @@index([stateCode])
  @@map("organization_gstins")
}

model Invoice {
  id             String @id @default(cuid())
  organizationId String @map("organization_id")
  orderId        String @map("order_id")
  sellerGstinId  String @map("seller_gstin_id")

  // Invoice identity
  invoiceNumber String   @map("invoice_number") // "INV-2025-26/000001"
  invoiceDate   DateTime @map("invoice_date")
  financialYear String   @map("financial_year") // "2025-26"

  // Seller snapshot (immutable copy at invoice time)
  sellerGstin     String @map("seller_gstin")
  sellerLegalName String @map("seller_legal_name")
  sellerAddress   Json?  @map("seller_address") @db.JsonB
  sellerStateCode String @map("seller_state_code")
  sellerStateName String @map("seller_state_name")

  // Dispatch-from snapshot: the additional place of business the goods left
  // from, when the org tracks warehouses. Snapshotted like the seller block so
  // the document never changes under the merchant. All null = dispatched from
  // the registered address (or the org does not track warehouses).
  dispatchWarehouseId String? @map("dispatch_warehouse_id")
  dispatchName        String? @map("dispatch_name")
  dispatchAddress     Json?   @map("dispatch_address") @db.JsonB
  dispatchStateCode   String? @map("dispatch_state_code") // GST 2-digit; spec App A `dispatch_state_code`

  // Buyer snapshot
  buyerName      String  @map("buyer_name")
  buyerGstin     String? @map("buyer_gstin") // null for B2C
  buyerAddress   Json?   @map("buyer_address") @db.JsonB
  buyerStateCode String  @map("buyer_state_code")
  buyerStateName String  @map("buyer_state_name")

  // Place of supply & GST type
  placeOfSupply     String  @map("place_of_supply") // State code
  placeOfSupplyName String  @map("place_of_supply_name")
  gstType           GstType @map("gst_type") // CGST_SGST or IGST

  // Tax totals
  subtotal       Decimal @db.Decimal(12, 2)
  totalCgst      Decimal @default(0) @map("total_cgst") @db.Decimal(12, 2)
  totalSgst      Decimal @default(0) @map("total_sgst") @db.Decimal(12, 2)
  totalIgst      Decimal @default(0) @map("total_igst") @db.Decimal(12, 2)
  totalTax       Decimal @default(0) @map("total_tax") @db.Decimal(12, 2)
  totalDiscount  Decimal @default(0) @map("total_discount") @db.Decimal(12, 2)
  // Shipping charged on the order, carried onto the invoice so grandTotal can
  // agree with Order.totalPrice. NOT taxed — treating shipping as a composite
  // supply would change the tax charged and is a deliberate decision, not an
  // oversight (see GstCalculatorService.calculateInvoiceTotals). It IS part of
  // grandTotal, which is why it has to be stored: without it the printed
  // invoice's total exceeds subtotal + tax by an amount nothing on the document
  // explains.
  shippingCharge Decimal @default(0) @map("shipping_charge") @db.Decimal(12, 2)

  /// Reconciliation against the tax the sales channel actually collected.
  /// The CRM's own computation remains this invoice's value — these columns
  /// only make a divergence visible before the return is filed.
  /// `chargedTax` NULL = never compared (offline order, or issued before this
  /// existed); it does not mean "compared and equal".
  /// NOTE (not expressible in Prisma): partial index
  ///   invoices_org_tax_mismatch_idx ON (organization_id) WHERE tax_mismatch
  chargedTax       Decimal? @map("charged_tax") @db.Decimal(12, 2)
  taxMismatchDelta Decimal? @map("tax_mismatch_delta") @db.Decimal(12, 2)
  taxMismatch      Boolean  @default(false) @map("tax_mismatch")

  /// Set on a CREDIT_NOTE row, pointing at the invoice it reverses.
  /// A credit note reuses this table because it is shaped like an invoice and
  /// must fold into the same return.
  /// NOTE (not expressible in Prisma): the one-live-invoice partial index now
  ///   reads WHERE status NOT IN ('CANCELLED', 'CREDIT_NOTE') — a credit note
  ///   must not occupy the single live-invoice slot for its order.
  creditNoteForId  String?   @map("credit_note_for_id")
  creditNoteReason String?   @map("credit_note_reason")
  creditNoteFor    Invoice?  @relation("InvoiceCreditNotes", fields: [creditNoteForId], references: [id], onDelete: Restrict)
  creditNotes      Invoice[] @relation("InvoiceCreditNotes")
  /// Any line on this invoice has no HSN code. Derivable by joining line items,
  /// but stored and partially indexed so the filing tab's warning is one index
  /// scan. Counts both null and the legacy '0000' as missing.
  /// NOTE (not expressible in Prisma): partial index
  ///   invoices_org_hsn_missing_idx ON (organization_id) WHERE hsn_missing
  hsnMissing       Boolean   @default(false) @map("hsn_missing")
  grandTotal       Decimal   @map("grand_total") @db.Decimal(12, 2)
  currency         String    @default("INR")

  // Status & metadata
  reverseCharge Boolean       @default(false) @map("reverse_charge")
  status        InvoiceStatus @default(ISSUED)
  notes         String?
  metadata      Json?         @db.JsonB
  cancelledAt   DateTime?     @map("cancelled_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order             Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerGstinRec    OrganizationGstin @relation(fields: [sellerGstinId], references: [id], onDelete: Restrict)
  // SetNull, unlike sellerGstinRec: the invoice carries its own dispatch
  // snapshot, so this FK is a pointer, not the record.
  dispatchWarehouse Warehouse?        @relation("InvoiceDispatchWarehouse", fields: [dispatchWarehouseId], references: [id], onDelete: SetNull)
  lineItems         InvoiceLineItem[]

  @@unique([organizationId, invoiceNumber])
  // NOTE (not expressible in Prisma): a PARTIAL unique index
  //   invoices_order_id_active_key ON (order_id)
  //     WHERE status NOT IN ('CANCELLED', 'CREDIT_NOTE')
  // enforces at most one LIVE invoice per order — see migration
  // 20260729130000_one_active_invoice_per_order. Cancelled invoices are exempt
  // so the statutory cancel-then-reissue flow keeps working.
  @@index([organizationId])
  @@index([orderId])
  @@index([sellerGstinId])
  @@index([dispatchWarehouseId])
  @@index([financialYear])
  @@index([invoiceDate])
  @@index([status])
  @@map("invoices")
}

model InvoiceLineItem {
  id              String        @id @default(cuid())
  invoiceId       String        @map("invoice_id")
  orderLineItemId String?       @map("order_line_item_id") // Traceability to original line item
  description     String // Product name + variant title
  /// NULLABLE since Phase 2. It was NOT NULL, so a product without an HSN got the
  /// invented literal '0000' written onto a statutory document. Readers must treat
  /// BOTH null and '0000' as missing — the pre-existing '0000' rows sit on issued
  /// invoices and are deliberately not rewritten.
  hsnCode         String?       @map("hsn_code") // HSN/SAC code
  /// Snapshotted at issue time, like every other statutory value here.
  unitOfMeasure   String?       @map("unit_of_measure")
  supplyType      GstSupplyType @default(TAXABLE) @map("supply_type")
  quantity        Int
  unitPrice       Decimal       @map("unit_price") @db.Decimal(12, 2)
  discount        Decimal       @default(0) @db.Decimal(12, 2)
  taxableValue    Decimal       @map("taxable_value") @db.Decimal(12, 2) // (unitPrice * qty) - discount
  gstRate         Decimal       @map("gst_rate") @db.Decimal(5, 2) // Full GST % (e.g. 18.00)
  cgstRate        Decimal       @default(0) @map("cgst_rate") @db.Decimal(5, 2)
  cgstAmount      Decimal       @default(0) @map("cgst_amount") @db.Decimal(12, 2)
  sgstRate        Decimal       @default(0) @map("sgst_rate") @db.Decimal(5, 2)
  sgstAmount      Decimal       @default(0) @map("sgst_amount") @db.Decimal(12, 2)
  igstRate        Decimal       @default(0) @map("igst_rate") @db.Decimal(5, 2)
  igstAmount      Decimal       @default(0) @map("igst_amount") @db.Decimal(12, 2)
  totalTax        Decimal       @default(0) @map("total_tax") @db.Decimal(12, 2)
  totalAmount     Decimal       @map("total_amount") @db.Decimal(12, 2)
  createdAt       DateTime      @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_line_items")
}

// ─── State Tax Rates & Collections ───────────────────────────────────────────

/// A period that has been FILED with the government.
///
/// Nothing recorded this before, so GSTR-1/3B were recomputed from `invoices`
/// on every request and cancelling or issuing an invoice inside an
/// already-filed month silently rewrote history with no amendment trail.
///
/// `totals` snapshots what was actually filed, so a later recomputation can be
/// compared against what went to the government rather than merely replacing it.
model GstFiling {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  financialYear  String   @map("financial_year")
  period         String
  /// Null means the filing covered ALL registrations — correct for a
  /// single-GSTIN org, which files one return.
  sellerGstinId  String?  @map("seller_gstin_id")
  returnType     String   @map("return_type")
  filedAt        DateTime @default(now()) @map("filed_at")
  filedById      String?  @map("filed_by_id")
  /// Acknowledgement Reference Number from the portal, when the merchant has it.
  arn            String?
  totals         Json?    @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// NOTE (not expressible in Prisma): the unique index is declared NULLS NOT
  /// DISTINCT, so a second all-registrations filing for the same period
  /// collides rather than silently duplicating.
  @@unique([organizationId, financialYear, period, returnType, sellerGstinId])
  @@index([organizationId])
  @@map("gst_filings")
}

/// A purchase the merchant records by hand — a gateway fee, a foreign SaaS
/// subscription, ad spend — with the GST on it.
///
/// ⚠️ NOTHING HERE REDUCES DECLARED TURNOVER. A sale keeps its full value
/// however much a gateway deducts before settling; these are SEPARATE inward
/// supplies whose tax is recovered through input credit. Netting them off sales
/// would under-declare revenue against figures the department cross-matches.
///
/// Rows flagged `isReverseCharge` feed GSTR-3B **3.1(d)** (the self-paid
/// liability) and **4(A)(3)** (the matching credit) — cash-neutral, but both
/// legs are declarable and omitting them is a visible non-declaration. That is
/// why this is not limited to payment gateways: Google Ads, Meta, AWS and Figma
/// are reverse charge too, and a 3.1(d) built from gateway fees alone would be
/// confidently too low.
///
/// ⚠️ NOT a purchase ledger. No line items, no HSN, no GSTR-2B matching, no
/// blocked-credit rules. It supports 4(A)(3) only — general ITC on domestic
/// purchases (4(A)(5)) stays out, and the exports must never say "Table 4"
/// unqualified or they imply a completeness this does not have.
///
/// PERIOD-LEVEL rather than per-order, deliberately: a third-party gateway's
/// fee is invisible to Shopify and arrives as a monthly statement, so the
/// record matches how the data actually shows up. A Shopify Payments sync would
/// aggregate into this same shape under `SHOPIFY_SYNC`.
model InwardSupply {
  id             String @id @default(cuid())
  organizationId String @map("organization_id")
  financialYear  String @map("financial_year")
  period         String

  /// Who charged it — "Shopify", "Google Ads", "Razorpay", "AWS". Free text,
  /// not an enum: the set is open and an enum would need a migration to accept
  /// the next one.
  supplier String

  /// The charge itself, excluding tax.
  feeAmount Decimal @map("fee_amount") @db.Decimal(12, 2)

  /// NULL means the invoice never told us the tax; 0.00 means it told us zero.
  /// The same contract as `OrderRefund.totalTax` and the channel-tax columns —
  /// summing NULL as zero would understate a tax claim while looking complete.
  gstAmount Decimal? @map("gst_amount") @db.Decimal(12, 2)

  /// Present ⇒ an ordinary domestic supply; the supplier remits the GST and you
  /// claim it. Absent ⇒ typically an import of services, where you self-pay the
  /// GST under reverse charge and reclaim the same amount.
  supplierGstin String? @map("supplier_gstin")

  /// Drives GSTR-3B 3.1(d) and 4(A)(3).
  ///
  /// ⚠️ Scoped to IMPORTS of services, which are always IGST — the recipient's
  /// location is the place of supply and the supplier sits outside India, so it
  /// is inter-state by definition. Domestic reverse charge (goods transport,
  /// advocates) is out of scope: it can be CGST+SGST and the head depends on
  /// the supplier's state.
  isReverseCharge Boolean @default(false) @map("is_reverse_charge")

  /// MANUAL | SHOPIFY_SYNC — stops a future auto-capture double-counting a
  /// figure somebody already entered by hand.
  source String @default("MANUAL")

  note      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// One row per supplier per period; a duplicate collides rather than silently
  /// doubling the claim.
  @@unique([organizationId, financialYear, period, supplier])
  @@index([organizationId, financialYear, period])
  @@map("inward_supplies")
}

model StateTaxRate {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  stateCode      String   @map("state_code") // 2-digit Indian state code
  stateName      String   @map("state_name") // Full state name
  gstRate        Decimal  @map("gst_rate") @db.Decimal(5, 2) // Default GST rate for this state
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, stateCode])
  @@index([organizationId])
  @@map("state_tax_rates")
}

model ProductTypeTaxRate {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  productType    String   @map("product_type") // e.g., "T-Shirts", "Electronics"
  gstRate        Decimal  @map("gst_rate") @db.Decimal(5, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, productType])
  @@index([organizationId])
  @@map("product_type_tax_rates")
}

model Collection {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  channelId      String    @map("channel_id")
  externalId     String    @map("external_id") // Shopify collection ID
  title          String
  handle         String? // URL-safe slug
  collectionType String    @map("collection_type") // "custom" or "smart"
  sortOrder      String?   @map("sort_order")
  publishedAt    DateTime? @map("published_at")
  metadata       Json?     @db.JsonB
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel      Channel                @relation(fields: [channelId], references: [id], onDelete: Cascade)
  products     ProductCollection[]
  taxOverride  CollectionTaxOverride?

  @@unique([channelId, externalId])
  @@index([organizationId])
  @@index([channelId])
  @@map("collections")
}

model ProductCollection {
  id           String   @id @default(cuid())
  productId    String   @map("product_id")
  collectionId String   @map("collection_id")
  position     Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([productId, collectionId])
  @@index([productId])
  @@index([collectionId])
  @@map("product_collections")
}

model CollectionTaxOverride {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  collectionId   String   @unique @map("collection_id") // One override per collection
  gstRate        Decimal  @map("gst_rate") @db.Decimal(5, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  collection   Collection   @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("collection_tax_overrides")
}

// Audit trail of every WhatsApp message our app tries to send on behalf of a
// merchant. One row per send attempt. Status transitions:
//   queued → sent → delivered → read     (happy path; delivered/read arrive via webhooks later)
//   queued → failed                      (Meta rejected the send)
model WhatsAppMessageLog {
  id               String    @id @default(cuid())
  organizationId   String    @map("organization_id")
  channelId        String    @map("channel_id")
  customerId       String?   @map("customer_id")
  orderId          String?   @map("order_id")
  templateName     String    @map("template_name") // e.g., "hello_world"
  templateLanguage String    @default("en_US") @map("template_language")
  triggerType      String?   @map("trigger_type") // "order_placed", "manual", etc.
  toPhone          String    @map("to_phone") // E.164 format
  externalId       String?   @map("external_id") // WhatsApp message id (wamid.*)
  status           String // queued | sent | delivered | read | failed
  errorCode        String?   @map("error_code")
  errorMessage     String?   @map("error_message")
  requestPayload   Json      @map("request_payload") @db.JsonB
  responsePayload  Json?     @map("response_payload") @db.JsonB
  sentAt           DateTime? @map("sent_at")
  deliveredAt      DateTime? @map("delivered_at")
  readAt           DateTime? @map("read_at")
  failedAt         DateTime? @map("failed_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel      Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  order        Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([orderId])
  @@index([externalId])
  @@map("whatsapp_message_logs")
}

// ─── Analytics ───────────────────────────────────────────────────────────────

enum AnalyticsGranularity {
  DAILY
  HOURLY
}

/// Channel-agnostic analytics snapshots. One row per (channel, date, granularity)
/// after the daily ingestion job runs. `metrics` holds the normalised payload
/// in JSON so the table stays stable when new metric columns appear in
/// ShopifyQL (or when Instagram/WhatsApp analytics get wired in later).
///
/// Source values:
///   "shopify_ql"          — fetched via `shopifyqlQuery` (sessions dataset).
///   "shopify_orders_fb"   — derived from local Order rows because ShopifyQL
///                           returned 406 (merchant on Basic plan).
///   "instagram_insights"  — reserved for Phase 2.
model AnalyticsSnapshot {
  id             String               @id @default(cuid())
  organizationId String               @map("organization_id")
  channelId      String               @map("channel_id")
  date           DateTime             @db.Date
  granularity    AnalyticsGranularity @default(DAILY)
  source         String // "shopify_ql" | "shopify_orders_fb" | "instagram_insights"
  /// Normalised metric payload. Shape (all optional except channel-specific minimums):
  /// {
  ///   sessions: number, pageviews: number, uniqueVisitors: number,
  ///   addedToCartRate: number, reachedCheckoutRate: number, conversionRate: number,
  ///   orders: number, revenue: number, currency: string,
  ///   byReferrer: [{ referrerSource: string, sessions: number, orders: number, revenue: number }],
  ///   byUtm: [{ utmSource: string, utmMedium: string, utmCampaign: string, sessions: number }]
  /// }
  metrics        Json                 @db.JsonB
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel      Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, date, granularity])
  @@index([organizationId, date])
  @@index([channelId, date])
  @@map("analytics_snapshots")
}

/// Raw per-event analytics records — populated by the Phase 2 Web Pixel
/// extension. Stubbed here so adding that ingest endpoint later won't require
/// a schema migration.
///   eventName: "page_viewed" | "product_viewed" | "product_added_to_cart"
///             | "checkout_started" | "checkout_completed" | ...
model RawAnalyticsEvent {
  id                 String   @id @default(cuid())
  organizationId     String   @map("organization_id")
  channelId          String   @map("channel_id")
  eventName          String   @map("event_name")
  occurredAt         DateTime @map("occurred_at")
  /// Stable per-visitor id supplied by the pixel; null for non-instrumented
  /// surfaces (server-side webhooks etc.).
  visitorId          String?  @map("visitor_id")
  /// Stable per-session id supplied by the pixel.
  sessionId          String?  @map("session_id")
  /// Shopify customer id if the visitor is identified.
  externalCustomerId String?  @map("external_customer_id")
  /// Free-form payload: product id, cart contents, referrer, utm, device, etc.
  payload            Json     @db.JsonB
  createdAt          DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel      Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([organizationId, occurredAt])
  @@index([channelId, occurredAt])
  @@index([eventName, occurredAt])
  @@index([sessionId])
  @@map("raw_analytics_events")
}
