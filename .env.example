# ──────────────────────────────────────────────────────────────────────────────
# Collabo CRM — Docker Compose Environment Variables
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# Then start the stack:
#   docker compose up -d
# ──────────────────────────────────────────────────────────────────────────────

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
# POSTGRES_PASSWORD is REQUIRED: compose refuses to start without it. Letters
# and digits only, as it goes into DATABASE_URL. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# It takes effect when the database is first created; to change it later, run
# ALTER USER in Postgres too.
POSTGRES_USER=collabo
POSTGRES_PASSWORD=
POSTGRES_DB=collabo_crm
# Published on 127.0.0.1 only (tools on this host); the app uses the compose network.
POSTGRES_PORT=5432

# ─── Redis ───────────────────────────────────────────────────────────────────
# Published on 127.0.0.1 only. Redis has no password, so never publish it wider.
REDIS_PORT=6379

# ─── App ─────────────────────────────────────────────────────────────────────
APP_PORT=80
FRONTEND_URL=http://localhost
APP_URL=http://localhost

# ─── JWT Secrets (REQUIRED — generate 32+ char random strings) ──────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_random_32_char_or_longer_string_aaaa
JWT_REFRESH_SECRET=replace_with_different_random_32_char_string_bbbb

# ─── Encryption Key (REQUIRED — exactly 32 characters) ──────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ENCRYPTION_KEY=replace_with_exactly_32_chars_xxxx

# ─── Email (SMTP via Nodemailer) ────────────────────────────────────────────
# Required in production. In development (NODE_ENV != production) emails are
# logged to console and SMTP is not contacted, so these can be left blank.
#
# Provider quick-reference:
#   Brevo           : host=smtp-relay.brevo.com     port=587  secure=false
#   SendGrid        : host=smtp.sendgrid.net        port=587  secure=false  user=apikey  pass=<SG API key>
#   AWS SES (SMTP)  : host=email-smtp.<region>.amazonaws.com  port=587  secure=false
#   Gmail/Workspace : host=smtp.gmail.com           port=587  secure=false  (App Password required)
#   Mailtrap (test) : host=sandbox.smtp.mailtrap.io port=2525 secure=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@collabo.store
FROM_NAME=Collabo CRM
REPLY_TO_EMAIL=support@collabo.store

# ─── Shopify Public App ─────────────────────────────────────────────────────
# Credentials of the CRM's public Shopify app (partners.shopify.com).
# The client secret is also the webhook HMAC signing key.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# MUST mirror [access_scopes] in the app's shopify.app.toml exactly.
SHOPIFY_SCOPES=
SHOPIFY_API_VERSION=2026-01

# ─── Meta (Instagram + WhatsApp) — Optional ─────────────────────────────────
# Shared Meta app credentials (same app handles both Instagram and WhatsApp).
META_APP_ID=
META_APP_SECRET=

# Instagram-specific
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# WhatsApp-specific
# WHATSAPP_CONFIG_ID — created in Meta dashboard under:
#   My Apps → <app> → Facebook Login for Business → Configurations
#   → New Configuration → "WhatsApp Embedded Signup" template
WHATSAPP_CONFIG_ID=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN — random 32-char string; used when Meta verifies
# the webhook URL. Set the same value in Meta dashboard → WhatsApp → Webhooks.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_GRAPH_VERSION — optional; defaults to v21.0 if unset
WHATSAPP_GRAPH_VERSION=v21.0

# Messenger + Instagram through Facebook Login for Business
MESSENGER_CONFIG_ID=
MESSENGER_WEBHOOK_VERIFY_TOKEN=

# Frontend — exposed to Vite build so the Meta JS SDK can initialize.
# Must mirror META_APP_ID above.
VITE_META_APP_ID=
